.cache
build-mac/
build/
*.pdf
pim_summary.json
compile_commands.json
scripts/__pycache__/

# Large reproducible simulator artifacts
simulator_results/**/*.bin
# Keep the small DPU runtime-argument dumps required by instruction analysis.
!simulator_results/**/input_DPU_INPUT_ARGUMENTS_*.bin

simulator_results/**/*.trace
simulator_results/**/trace.txt

# Verbose console output
simulator_results/**/console.log

# Interrupted runs
simulator_results/**/*.incomplete.*/

# Temporary files
simulator_results/**/*.tmp
simulator_results/**/.DS_Store
.venv/
